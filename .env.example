# Copy to .env and fill (same Supabase DB as AI-SOC).
# Prefer Session pooler host (aws-*-REGION.pooler.supabase.com:5432).
# Keep user/password OUT of the JDBC URL — @ in passwords breaks URI parsing.

GOVIEW_DB_URL=jdbc:postgresql://aws-1-ap-south-1.pooler.supabase.com:5432/postgres?sslmode=require
GOVIEW_DB_USER=postgres.YOUR_PROJECT_REF
GOVIEW_DB_PASSWORD=YOUR_DB_PASSWORD

# Optional — only needed for legacy /signup email codes (not AI-SOC SSO).
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=no-reply@example.com
# SENDGRID_FROM_NAME=Vscreen

# Start with:  .\run-dev.ps1
# (plain `mvnd spring-boot:run` will NOT load .env unless you export these yourself)