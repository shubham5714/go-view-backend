# Shared env for GoView / vScreen backend (Windows .env or Linux EnvironmentFile).
# Copy to .env (Windows) or /opt/goview/goview.env (Ubuntu systemd).

# --- Required: Postgres / Supabase Transaction pooler (PgBouncer :6543) ---
# Keep user/password OUT of the JDBC URL — @ in passwords breaks URI parsing.
# prepareThreshold=0 is required for transaction-mode pooling (no server prepared statements).
GOVIEW_DB_URL=jdbc:postgresql://aws-1-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
GOVIEW_DB_USER=postgres.YOUR_PROJECT_REF
GOVIEW_DB_PASSWORD=YOUR_DB_PASSWORD

# --- Runtime ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8083

# --- Upload / static file mapping ---
# Windows (defaults in application.yml if unset):
#   GOVIEW_OSS_FILE=file:D:/upload/
#   GOVIEW_FILE_URL=D:/upload
#   GOVIEW_HTTP_URL=http://127.0.0.1:8083/
# Ubuntu service:
#   GOVIEW_OSS_FILE=file:/opt/goview/upload/
#   GOVIEW_FILE_URL=/opt/goview/upload
#   GOVIEW_HTTP_URL=https://your-public-host/

# Optional — legacy /signup email codes only (not AI-SOC SSO).
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=no-reply@example.com
# SENDGRID_FROM_NAME=Vscreen
